<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/scrollSubStyle"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:clipChildren="false"
    android:clipToPadding="false"
    android:fadeScrollbars="true"
    android:overScrollMode="never"
    android:paddingHorizontal="18dp"
    android:paddingTop="8dp"
    android:paddingBottom="8dp"
    android:scrollbars="vertical"
    android:verticalScrollbarPosition="left">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:orientation="vertical">

        <!-- اندازه فونت -->
        <TextView
            android:id="@+id/txtSubSize"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/subtitle_size_label"
            android:textColor="#FFFFFF"
                android:textSize="13sp"
            android:textStyle="bold" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="40dp"
            android:layout_marginBottom="6dp"
            android:clipChildren="false"
            android:clipToPadding="false"
            android:gravity="center_vertical"
            android:orientation="horizontal">


            <SeekBar
                android:id="@+id/seekSubSize"
                android:layout_width="match_parent"
                android:layout_height="34dp"
                android:background="@drawable/item_focus_selector"
                android:focusable="true"
                android:max="80" />

        </LinearLayout>

        <!-- موقعیت عمودی -->
        <TextView
            android:id="@+id/txtSubPos"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/subtitle_pos_label"
            android:textColor="#FFFFFF"
                android:textSize="13sp"
            android:textStyle="bold" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="40dp"
            android:layout_marginBottom="6dp"
            android:clipChildren="false"
            android:clipToPadding="false"
            android:gravity="center_vertical"
            android:orientation="horizontal">


            <SeekBar
                android:id="@+id/seekSubPos"
                android:layout_width="match_parent"
                android:layout_height="34dp"
                android:background="@drawable/item_focus_selector"
                android:focusable="true"
                android:max="100" />

        </LinearLayout>

        <!-- ضخامت حاشیه و سایه -->
        <TextView
            android:id="@+id/txtSubBorder"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/subtitle_border_label"
            android:textColor="#FFFFFF"
                android:textSize="13sp"
            android:textStyle="bold" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="40dp"
            android:layout_marginBottom="8dp"
            android:clipChildren="false"
            android:clipToPadding="false"
            android:gravity="center_vertical"
            android:orientation="horizontal">


            <SeekBar
                android:id="@+id/seekSubBorder"
                android:layout_width="match_parent"
                android:layout_height="34dp"
                android:background="@drawable/item_focus_selector"
                android:focusable="true"
                android:max="60" />

        </LinearLayout>

        <!-- رنگ متن -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="6dp"
            android:text="@string/subtitle_text_color_label"
            android:textColor="#FFFFFF"
                android:textSize="13sp"
            android:textStyle="bold" />

        <HorizontalScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="10dp"
            android:clipChildren="false"
            android:clipToPadding="false"
            android:focusable="false"
            android:overScrollMode="never"
            android:scrollbars="none">

            <LinearLayout
                android:id="@+id/colorChipsContainer"
                android:layout_width="wrap_content"
                android:layout_height="46dp"
                android:clipChildren="false"
                android:clipToPadding="false"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingHorizontal="4dp" />
        </HorizontalScrollView>

        <!-- کادر پس‌زمینه -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="6dp"
            android:text="@string/subtitle_bg_color_label"
            android:textColor="#FFFFFF"
                android:textSize="13sp"
            android:textStyle="bold" />

        <HorizontalScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="10dp"
            android:clipChildren="false"
            android:clipToPadding="false"
            android:focusable="false"
            android:overScrollMode="never"
            android:scrollbars="none">

            <LinearLayout
                android:id="@+id/bgChipsContainer"
                android:layout_width="wrap_content"
                android:layout_height="44dp"
                android:clipChildren="false"
                android:clipToPadding="false"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingHorizontal="4dp" />
        </HorizontalScrollView>

        <!-- چک‌باکس Bold -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:clipChildren="false"
            android:clipToPadding="false"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <CheckBox
                android:id="@+id/switchSubBold"
                android:textColor="#FFFFFF"
                android:layout_width="match_parent"
                android:layout_height="42dp"
                android:background="@drawable/item_focus_selector"
                android:focusable="true"
                android:paddingHorizontal="8dp"
                android:text="@string/subtitle_bold"
                android:textSize="13sp" />
        </LinearLayout>

    </LinearLayout>
</ScrollView>
