<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/scrollSubStyle"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:fadeScrollbars="false"
    android:overScrollMode="never"
    android:paddingHorizontal="18dp"
    android:paddingTop="8dp"
    android:paddingBottom="4dp"
    android:verticalScrollbarPosition="left">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:descendantFocusability="blocksDescendants"
        android:orientation="vertical">

        <!-- اندازه فونت -->
        <TextView
            android:id="@+id/txtSubSize"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/subtitle_size_label"
            android:textSize="13sp"
            android:textStyle="bold" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="38dp"
            android:layout_marginBottom="6dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/btnSizeMinus"
                android:layout_width="36dp"
                android:layout_height="32dp"
                android:background="?selectableItemBackgroundBorderless"
                android:clickable="true"
                android:focusable="false"
                android:gravity="center"
                android:text="−"
                android:textSize="20sp"
                android:textStyle="bold" />

            <SeekBar
                android:id="@+id/seekSubSize"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:max="80" />

            <TextView
                android:id="@+id/btnSizePlus"
                android:layout_width="36dp"
                android:layout_height="32dp"
                android:background="?selectableItemBackgroundBorderless"
                android:clickable="true"
                android:focusable="false"
                android:gravity="center"
                android:text="+"
                android:textSize="20sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- موقعیت عمودی -->
        <TextView
            android:id="@+id/txtSubPos"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/subtitle_pos_label"
            android:textSize="13sp"
            android:textStyle="bold" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="38dp"
            android:layout_marginBottom="6dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/btnPosMinus"
                android:layout_width="36dp"
                android:layout_height="32dp"
                android:background="?selectableItemBackgroundBorderless"
                android:clickable="true"
                android:focusable="false"
                android:gravity="center"
                android:text="−"
                android:textSize="20sp"
                android:textStyle="bold" />

            <SeekBar
                android:id="@+id/seekSubPos"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:max="100" />

            <TextView
                android:id="@+id/btnPosPlus"
                android:layout_width="36dp"
                android:layout_height="32dp"
                android:background="?selectableItemBackgroundBorderless"
                android:clickable="true"
                android:focusable="false"
                android:gravity="center"
                android:text="+"
                android:textSize="20sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- ضخامت حاشیه و سایه -->
        <TextView
            android:id="@+id/txtSubBorder"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/subtitle_border_label"
            android:textSize="13sp"
            android:textStyle="bold" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="38dp"
            android:layout_marginBottom="8dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/btnBorderMinus"
                android:layout_width="36dp"
                android:layout_height="32dp"
                android:background="?selectableItemBackgroundBorderless"
                android:clickable="true"
                android:focusable="false"
                android:gravity="center"
                android:text="−"
                android:textSize="20sp"
                android:textStyle="bold" />

            <SeekBar
                android:id="@+id/seekSubBorder"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:max="60" />

            <TextView
                android:id="@+id/btnBorderPlus"
                android:layout_width="36dp"
                android:layout_height="32dp"
                android:background="?selectableItemBackgroundBorderless"
                android:clickable="true"
                android:focusable="false"
                android:gravity="center"
                android:text="+"
                android:textSize="20sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- رنگ متن (دکمه‌های رنگی تک‌کلیکی) -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="6dp"
            android:text="@string/subtitle_text_color_label"
            android:textSize="13sp"
            android:textStyle="bold" />

        <HorizontalScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="10dp"
            android:overScrollMode="never"
            android:scrollbars="none">

            <LinearLayout
                android:id="@+id/colorChipsContainer"
                android:layout_width="wrap_content"
                android:layout_height="42dp"
                android:gravity="center_vertical"
                android:orientation="horizontal" />
        </HorizontalScrollView>

        <!-- کادر پس‌زمینه (دکمه‌های تک‌کلیکی) -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="6dp"
            android:text="@string/subtitle_bg_color_label"
            android:textSize="13sp"
            android:textStyle="bold" />

        <LinearLayout
            android:id="@+id/bgChipsContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="10dp"
            android:gravity="center_vertical"
            android:orientation="horizontal" />

        <!-- سوئیچ‌های Bold و ASS در یک ردیف فشرده و خوش‌دست -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <androidx.appcompat.widget.SwitchCompat
                android:id="@+id/switchSubBold"
                android:layout_width="0dp"
                android:layout_height="42dp"
                android:layout_weight="1"
                android:focusable="false"
                android:paddingEnd="8dp"
                android:text="@string/subtitle_bold"
                android:textSize="13sp" />

            <androidx.appcompat.widget.SwitchCompat
                android:id="@+id/switchAssOverride"
                android:layout_width="0dp"
                android:layout_height="42dp"
                android:layout_weight="1"
                android:focusable="false"
                android:paddingStart="8dp"
                android:text="@string/subtitle_ass_override"
                android:textSize="13sp" />
        </LinearLayout>

    </LinearLayout>
</ScrollView>
