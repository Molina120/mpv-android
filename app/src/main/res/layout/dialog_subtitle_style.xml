<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layoutDirection="rtl"
    android:paddingHorizontal="20dp"
    android:paddingVertical="12dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- اندازه فونت -->
        <TextView
            android:id="@+id/txtSubSize"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="اندازه زیرنویس: 55"
            android:textStyle="bold" />

        <SeekBar
            android:id="@+id/seekSubSize"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:layout_marginBottom="12dp"
            android:minHeight="48dp"
            android:max="80" />

        <!-- موقعیت عمودی -->
        <TextView
            android:id="@+id/txtSubPos"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="موقعیت عمودی: 100 (۰=بالا، ۱۰۰=پایین)"
            android:textStyle="bold" />

        <SeekBar
            android:id="@+id/seekSubPos"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:layout_marginBottom="12dp"
            android:minHeight="48dp"
            android:max="100" />

        <!-- ضخامت حاشیه و سایه -->
        <TextView
            android:id="@+id/txtSubBorder"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="ضخامت حاشیه (Outline): 3.0"
            android:textStyle="bold" />

        <SeekBar
            android:id="@+id/seekSubBorder"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:layout_marginBottom="12dp"
            android:minHeight="48dp"
            android:max="60" />

        <!-- رنگ متن و کادر پس‌زمینه: کنار هم در یک ردیف (مناسب حالت افقی) -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="12dp">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:paddingEnd="8dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="رنگ متن زیرنویس:"
                    android:textStyle="bold" />

                <Spinner
                    android:id="@+id/spinnerSubColor"
                    android:layout_width="match_parent"
                    android:layout_height="48dp" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:paddingStart="8dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="کادر پس‌زمینه زیرنویس:"
                    android:textStyle="bold" />

                <Spinner
                    android:id="@+id/spinnerSubBgColor"
                    android:layout_width="match_parent"
                    android:layout_height="48dp" />
            </LinearLayout>
        </LinearLayout>

        <!-- برجسته کردن (Bold) -->
        <androidx.appcompat.widget.SwitchCompat
            android:id="@+id/switchSubBold"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            android:text="برجسته کردن متن (Bold)" />

        <!-- اعمال روی زیرنویس‌های ASS -->
        <androidx.appcompat.widget.SwitchCompat
            android:id="@+id/switchAssOverride"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="اعمال اجباری فونت و استایل روی زیرنویس‌های ASS" />

    </LinearLayout>
</ScrollView>
