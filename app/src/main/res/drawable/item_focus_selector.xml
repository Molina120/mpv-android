<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- حالت فوکوس با کنترل تلویزیون یا انتخاب در نوار پلیر -->
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <solid android:color="#2E00B0FF" />
            <corners android:radius="8dp" />
            <stroke android:width="2dp" android:color="#00E5FF" />
        </shape>
    </item>
    <item android:state_selected="true">
        <shape android:shape="rectangle">
            <solid android:color="#2E00B0FF" />
            <corners android:radius="8dp" />
            <stroke android:width="2dp" android:color="#00E5FF" />
        </shape>
    </item>
    <!-- حالت فشردن دکمه OK کنترل یا لمس -->
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <solid android:color="#4D00B0FF" />
            <corners android:radius="8dp" />
            <stroke android:width="2dp" android:color="#00B0FF" />
        </shape>
    </item>
    <!-- حالت عادی -->
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@android:color/transparent" />
        </shape>
    </item>
</selector>
